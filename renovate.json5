{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  labels: ["dependencies"],
  packageRules: [
    {
      description: "Group Wolfi base image updates",
      matchPackageNames: ["cgr.dev/chainguard/wolfi-base"],
      groupName: "wolfi-base"
    },
    {
      description: "Auto-merge upstream container image updates (per-app versions in docker-bake.hcl + Wolfi base image)",
      matchDatasources: ["docker"],
      automerge: true,
      platformAutomerge: true
    },
    {
      description: "Auto-merge the sprout-track fork main-branch digest bumps",
      matchDatasources: ["git-refs"],
      matchDepNames: ["TomGrozev/sprout-track"],
      automerge: true,
      platformAutomerge: true
    }
  ],
  customManagers: [
    {
      customType: "regex",
      // r3 is excluded here: its VERSION tracks GitHub *releases* tagged `vX.Y.Z`
      // and needs `extractVersion` to strip the leading `v` (the dedicated manager
      // below). Every other app's VERSION tracks a container image tag (docker
      // datasource, no `v` stripping) — see the negative lookahead.
      managerFilePatterns: ["/apps/(?!r3/)[^/]+/docker-bake\\.hcl$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)[\\s\\S]*?variable\\s+\"VERSION\"\\s*\\{\\s*default\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      versioningTemplate: "docker"
    },
    {
      description: "Track the r3 GitHub release (datasource=github-releases) and bump VERSION without the leading `v`",
      customType: "regex",
      managerFilePatterns: ["/apps/r3/docker-bake\\.hcl$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)[\\s\\S]*?variable\\s+\"VERSION\"\\s*\\{\\s*default\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      versioningTemplate: "semver",
      extractVersionTemplate: "^v?(?<version>.+)$"
    },
    {
      description: "Track the sprout-track fork's main HEAD as a git-refs digest pin (sprout-track-fork image)",
      customType: "regex",
      managerFilePatterns: ["/apps/sprout-track-fork/docker-bake\\.hcl$/"],
      matchStrings: [
        "variable\\s+\"REF\"\\s*\\{\\s*default\\s*=\\s*\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      currentValueTemplate: "main",
      depNameTemplate: "TomGrozev/sprout-track",
      packageNameTemplate: "https://github.com/TomGrozev/sprout-track",
      datasourceTemplate: "git-refs"
    }
  ]
}
