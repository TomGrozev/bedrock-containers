target "docker-metadata-action" {}

variable "APP" {
  default = "<app>"
}

variable "VERSION" {
  default = "<UPSTREAM_VERSION>"
}

variable "SOURCE" {
  default = "<UPSTREAM_SOURCE_URL>"
}

group "default" {
  targets = ["image-local"]
}

target "image" {
  inherits = ["docker-metadata-action"]
  args = {
    VERSION = "${VERSION}"
  }
  labels = {
    "org.opencontainers.image.source" = "${SOURCE}"
  }
}

target "image-local" {
  inherits = ["image"]
  output = ["type=docker"]
  tags = ["${APP}:${VERSION}"]
}

target "image-all" {
  inherits = ["image"]
  platforms = [
    "linux/amd64",
    "linux/arm64"
  ]
}
